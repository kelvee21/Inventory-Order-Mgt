# Local connection template. Copy to .env if your tooling reads it.
# The SQL scripts themselves do not read this file; MySQL Workbench
# stores its own connection profile, and the CLI uses MYSQL_PWD or
# an option file. Never commit the real password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=inventory_order_mgt
